# Alnyron — environment contract. Copy to .env.local (git-ignored).
# Real secrets live only in .env.local (dev) and CI/Cloudflare (prod), never committed.

# Public (inlined into the client bundle)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (read lazily inside functions, never at module top level)
RESEND_API_KEY=
MAIL_FROM=Alnyron <noreply@send.alnyron.dk>

# Dev tooling only, never deployed: integration tests (tests/integration) + `npm run db:push`
SUPABASE_DB_PASSWORD=
# Optional CA certificate for verify-full TLS to the pooler (default supabase/prod-ca-2021.crt)
# SUPABASE_DB_CA_CERT=

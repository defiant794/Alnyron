# Alnyron: environment contract. Split by who may read each value:
#   .env.local      the app only (`next dev` / `next build`). @opennextjs/cloudflare compiles every
#                   root .env* file (.env, .env.<mode>, .env.local, .env.<mode>.local) into the
#                   Worker bundle, so it holds no secret. Copy the "App" block to .env.local.
#   server secrets  in no file the build reads: see the "Server secrets" block. `npm run cf:build`
#                   fails if one of them (or a test secret below) reaches the Worker bundle.
#   tests/.env.e2e  test tooling only, never bundled. Copy the "Tests" block to tests/.env.e2e
#                   and uncomment the keys.
# Production: plain (not secret) values in wrangler.jsonc "vars", like MAIL_FROM: every deploy sets
# the Worker's plain vars from that block alone. Secrets with `wrangler secret put`, never
# committed. A value set in the environment wins.

# ── App: .env.local ─────────────────────────────────────────────────────────────
# Public (inlined into the client bundle)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Project URL only (https://<ref>.supabase.co), not the /rest/v1/ endpoint
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, not secret (read lazily inside functions, never at module top level)
MAIL_FROM=Alnyron <noreply@send.alnyron.dk>
# Stripe, Monitor subscription (plain ids, not secret): the 25% inclusive "Moms" Tax Rate and the
# Billing Portal configuration. scripts/stripe-setup.mjs creates both and prints the ids: test-mode
# ids here, live ids in wrangler.jsonc "vars" (see below).
STRIPE_TAX_RATE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# The Stripe mode this deployment runs in: "false" (test mode) here and in every non-production
# environment, "true" only on the production Worker. The app refuses STRIPE_CHECKOUT_KEY when its
# mode (`_test_` / `_live_`) differs, so production never runs on a test key and no other server
# on a live key.
# Production: at go-live, once the live ids exist, add "STRIPE_LIVEMODE": "true" and the live
# STRIPE_TAX_RATE_ID and STRIPE_PORTAL_CONFIGURATION_ID to wrangler.jsonc "vars", beside
# MAIL_FROM. Only STRIPE_CHECKOUT_KEY is a secret (`wrangler secret put`). `npm run preview` runs
# the built Worker with those vars, and they win over .env.local, so a preview with a test key then
# needs STRIPE_LIVEMODE=false and the test-mode ids in .dev.vars, which override them.
STRIPE_LIVEMODE=false

# ── Server secrets: never in a root .env* file ──────────────────────────────────
# Read lazily inside functions, never at module top level. Set them in the shell environment for
# `npm run dev` / `npm run start`, in the git-ignored .dev.vars for `npm run preview` (read by
# wrangler only, never compiled into the bundle) and with `wrangler secret put` for the deployed
# Worker.
# RESEND_API_KEY=
# Stripe key for the Monitor subscription's Checkout and Billing Portal sessions. Production: a
# restricted `rk_live_` key with only "Checkout Sessions: write" and "Customer portal: write"
# (`wrangler secret put STRIPE_CHECKOUT_KEY`); the app refuses a full `sk_live_` secret key
# (only `scripts/stripe-setup.mjs --live` takes one, from the shell). Locally a test-mode key
# (`sk_test_` or `rk_test_`). The local test-mode setup
# (`node --env-file=.env.local scripts/stripe-setup.mjs`) may read it from .env.local, but take it
# out of every root .env* file before `npm run cf:build`: OpenNext bundles them and the guard
# then fails the build (as for RESEND_API_KEY; the guard also fails on any live key's value).
# STRIPE_CHECKOUT_KEY=

# ── Tests: tests/.env.e2e (NEVER .env.local or .env.test.local: both are bundled) ─
# Project DB password: integration tests (tests/integration), the e2e DB fixtures
# (tests/e2e/fixtures). `npm run db:push` reads it from the environment, e.g.
# node --env-file=tests/.env.e2e node_modules/supabase/dist/supabase.js db push --linked
# SUPABASE_DB_PASSWORD=
# Optional CA certificate for verify-full TLS to the pooler (default supabase/prod-ca-2021.crt)
# SUPABASE_DB_CA_CERT=
# e2e only (tests/e2e/fixtures/admin-auth-seed.ts: generate_link for the invite and reset
# flows). Secret key from the Supabase dashboard. The app has no secret key: never read by app
# code, never in .env.local.
# SUPABASE_SECRET_KEY=

# ── e2e against a production build: shell environment only, in no file ───────────
# Shared secret for the test-only POST /api/test/revalidate (tests/e2e/fixtures/revalidate.ts),
# which refreshes the ISR cache after a DB fixture change. A strong random value, generated with
# `openssl rand -hex 32`, set to the same value for both `npm run start` and `npm run test:e2e`.
# Not in tests/.env.e2e: `npm run dev` never has it, so a dev-server run must not send it. The
# test run only sends it to a loopback PLAYWRIGHT_BASE_URL (localhost, 127.0.0.1, [::1]). The
# route 404s while the server has no value, so never set it in .env.local or in Cloudflare
# (`npm run cf:build` fails if it reaches the Worker bundle).
# E2E_REVALIDATE_SECRET=

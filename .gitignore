# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next*/
/out/

# production
/build

# cloudflare / opennext
/.open-next/
/.wrangler/
# The Workers' wrangler output and local state (wrangler resolves them from each config's directory).
/workers/monitor-cron/.wrangler/
/workers/payments/.wrangler/
cloudflare-env.d.ts
# Worker secrets for `wrangler dev` (`.dev.vars`, `.dev.vars.<env>`); only the examples are tracked.
.dev.vars*
!.dev.vars.example

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit)
.env
.env.*
!.env.example
# test-only secrets (DB password, e2e service key): kept out of the root, where
# @opennextjs/cloudflare compiles every .env* file into the Worker bundle
tests/.env.e2e
# catalog-public E2E isolated project credentials (never the prod project)
tests/.env.e2e-project

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OMP planning artifacts live in the Jottacloud workspace, never the code repo
.omp/

# local e2e dev server log
.e2e-server.log

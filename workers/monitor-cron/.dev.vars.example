# Copy to workers/monitor-cron/.dev.vars (git-ignored) for `wrangler dev --config workers/monitor-cron/wrangler.jsonc`.
# Local runs use the ISOLATED e2e Supabase project only, never production: override SUPABASE_URL here.
SUPABASE_URL=https://<e2e-project-ref>.supabase.co
SUPABASE_SECRET_KEY=<e2e project secret key>
RESEND_API_KEY=<Resend test or sending key>

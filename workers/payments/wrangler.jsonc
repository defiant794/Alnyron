{
  // Cloudflare Worker "alnyron-payments": Stripe's webhook endpoint (payments slice 1c) and the
  // right of withdrawal (fortrydelsesret, slice 1d). Stripe POSTs subscription, Checkout and
  // invoice events to https://pay.alnyron.dk/webhook; index.ts's fetch() checks the signature,
  // retrieves the subscription's current state from Stripe and writes it through the
  // service-role-only payments_sync_subscription / payments_record_subscription_invoice functions
  // (migration 20261112000100), cancels and refunds a duplicate subscription from parallel
  // Checkouts, and records a Checkout's consent (migration 20261114000300) with its order
  // confirmation email. The named entrypoint WithdrawalService (withdrawal-service.ts) is reached
  // only from the web Worker over its service binding PAYMENTS (root wrangler.jsonc), never over a
  // route. See README.md.
  // Separate from the OpenNext web Worker (root wrangler.jsonc) so the Supabase secret key, the
  // Stripe key and the Resend key never sit in the public app's bundle. No workers.dev URL, no
  // previews.
  //
  // Cron: "0 * * * *" (hourly, minute 0, UTC) runs scheduled() = the sweep (sweep.ts): finishes
  // withdrawals a call left undone (cancel, refund, receipt, owner alert) and resends unsent order
  // confirmations, making 45 subrequests a run at most (Workers Free allows 50, per Cloudflare's
  // docs as of 2026-11).
  //
  // Build / deploy (always pass --config; without it wrangler hands off to OpenNext):
  //   npm run build:payments    (wrangler deploy --dry-run … --outdir .wrangler/payments)
  //   npm run deploy:payments   (NOT chained into `npm run deploy`: shipped by hand at go-live,
  //                              BEFORE the web Worker, whose PAYMENTS binding needs this Worker)
  // Secrets (never in vars, never in a root .env* file):
  //   wrangler secret put SUPABASE_SECRET_KEY --config workers/payments/wrangler.jsonc
  //   wrangler secret put STRIPE_WEBHOOK_SECRET --config workers/payments/wrangler.jsonc
  //   wrangler secret put STRIPE_PAYMENTS_KEY --config workers/payments/wrangler.jsonc
  //   wrangler secret put RESEND_API_KEY --config workers/payments/wrangler.jsonc
  // Local runs read workers/payments/.dev.vars (see .dev.vars.example and README.md), which must
  // point at the e2e Supabase project and Stripe test mode (STRIPE_LIVEMODE=false).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alnyron-payments",
  "main": "./index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // No "routes"/"route" key: the custom domain pay.alnyron.dk is attached in the dashboard. Per
  // Cloudflare's docs (Wrangler configuration > Source of truth), a deploy replaces routes changed in
  // the dashboard with the config's routes, and dashboard-only routes need no route/routes key plus
  // workers_dev = false, so a routes key could make wrangler manage (and drop) the domain; the same
  // convention as the web Worker's custom domains (root wrangler.jsonc; monitor-cron has no domain).
  "vars": {
    "SUPABASE_URL": "https://xmgpixhxecamtryohgmk.supabase.co",
    // Production processes live-mode events only; test-mode deliveries are answered and ignored.
    "STRIPE_LIVEMODE": "true",
    // The withdrawal emails' sender: the same verified Resend domain as the web Worker's MAIL_FROM.
    "MAIL_FROM": "Alnyron <noreply@send.alnyron.dk>",
    // Where the owner alert about a withdrawal that needs manual handling goes (README runbook).
    "WITHDRAWAL_ALERT_TO": "info@alnyron.dk",
    // The main site: the emails link its /terms page and the Monitor withdraw page.
    "SITE_URL": "https://alnyron.dk"
  },
  "triggers": { "crons": ["0 * * * *"] }
}

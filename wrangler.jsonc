{
  // Cloudflare Workers config (OpenNext). ISR cache = KV (no payment card).
  // open-next.config.ts wires the KV incremental cache (binding NEXT_INC_CACHE_KV).
  // KV namespace "NEXT_INC_CACHE_KV" was created with
  // `wrangler kv namespace create NEXT_INC_CACHE_KV` (the id is not a secret).
  // Deploy = Cloudflare Workers Builds connected to the GitHub repo
  // (runs `cf:build` on Linux).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alnyron-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "4a4c256304c143dc89b8685b5a835c3a" }
  ],
  "vars": { "MAIL_FROM": "Alnyron <noreply@send.alnyron.dk>" }
}

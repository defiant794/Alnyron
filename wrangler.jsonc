{
  // Cloudflare Workers config (OpenNext). ISR cache = KV (no payment card).
  // open-next.config.ts wires the KV incremental cache (binding NEXT_INC_CACHE_KV).
  // Replace the KV "id" below with the real namespace id once it is created
  // (Cloudflare dashboard -> Storage & Databases -> KV -> "alnyron-next-inc-cache",
  // or `wrangler kv namespace create NEXT_INC_CACHE_KV`). Deploy = Cloudflare
  // Workers Builds connected to the GitHub repo (runs `cf:build` on Linux).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alnyron-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "PLACEHOLDER_SET_AT_DEPLOY" }
  ],
  "vars": { "MAIL_FROM": "Alnyron <noreply@send.alnyron.dk>" }
}

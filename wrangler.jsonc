{
  // Cloudflare Workers config (OpenNext) for the prod Worker "alnyron-web".
  // open-next.config.ts uses these bindings: NEXT_INC_CACHE_KV (ISR cache),
  // NEXT_TAG_CACHE_D1 (tag cache), NEXT_CACHE_DO_QUEUE (revalidation queue),
  // WORKER_SELF_REFERENCE (self-call that regenerates stale pages).
  // Deploy = Cloudflare Workers Builds connected to the GitHub repo (runs
  // `cf:build` on Linux). The deploy must go through `opennextjs-cloudflare
  // deploy` (wrangler 4.x `wrangler deploy` delegates to it automatically in
  // this OpenNext project): its populateCache seeds the KV cache and creates
  // the D1 `revalidations` table the tag cache reads.
  // KV namespace "NEXT_INC_CACHE_KV" was created with
  // `wrangler kv namespace create NEXT_INC_CACHE_KV`. The D1 database
  // (database_id below) was created with
  // `wrangler d1 create alnyron-web-tag-cache`.
  // Ids are not secrets.
  // The DO SQLite migration "v1" is one-way once deployed: never edit or
  // remove it; add a new tag instead.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alnyron-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "4a4c256304c143dc89b8685b5a835c3a" }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "alnyron-web-tag-cache",
      "database_id": "d13af5da-574f-4f93-a4fa-d411ad9c693c"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "alnyron-web" }],
  // Per-user throttle on the Monitor billing actions (src/lib/payments/rate-limit.ts):
  // BILLING_RATE_LIMIT sessions per BILLING_RATE_PERIOD_SECONDS (src/config/payments.ts;
  // a unit test pins these numbers to them). Workers Rate Limiting: nothing to create
  // in the dashboard; namespace_id is an integer string of our choosing, unique in the
  // Cloudflare account; period is 10 or 60. Simulated locally by `next dev`.
  "ratelimits": [
    {
      "name": "BILLING_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Plain (not secret) Worker vars: every deploy sets the Worker's plain vars from this
  // block alone. At go-live, once the live Stripe ids exist, add "STRIPE_LIVEMODE": "true"
  // and the live STRIPE_TAX_RATE_ID and STRIPE_PORTAL_CONFIGURATION_ID here (.env.example);
  // STRIPE_CHECKOUT_KEY is a secret (`wrangler secret put`).
  "vars": { "MAIL_FROM": "Alnyron <noreply@send.alnyron.dk>" }
}
